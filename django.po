#: evidence/forms.py:19
msgid "Date observed"
msgstr "Tarehe ya uchunguzi"

#: evidence/forms.py:20 evidence/templates/evidence/project_detail.html:33
msgid "Status"
msgstr "Hali"

#: evidence/forms.py:21 evidence/templates/evidence/project_detail.html:39
msgid "Description"
msgstr "Maelezo"

#: evidence/forms.py:22
msgid "Evidence type"
msgstr "Aina ya ushahidi"

#: evidence/forms.py:23
msgid "Evidence note"
msgstr "Maelezo ya ushahidi"

#: evidence/forms.py:24
msgid "Your name"
msgstr "Jina lako"

#: evidence/forms.py:31
msgid "What did you see, and where?"
msgstr "Uliona nini, na mahali gani?"

#: evidence/forms.py:36
msgid "e.g. Photo taken at the site entrance"
msgstr "mfano: Picha iliyopigwa langoni pa eneo"

#: evidence/forms.py:42
msgid "Optional — leave blank to stay anonymous"
msgstr "Si lazima — acha wazi ili kubaki bila jina"

#: evidence/models.py:19
msgid "Completed"
msgstr "Imekamilika"

#: evidence/models.py:20
msgid "Ongoing"
msgstr "Inaendelea"

#: evidence/models.py:21
msgid "Planned"
msgstr "Imepangwa"

#: evidence/models.py:22
msgid "Stalled"
msgstr "Imesimama"

#: evidence/models.py:106
msgid "No evidence yet"
msgstr "Bado hakuna ushahidi"

#: evidence/models.py:108
msgid "No community observations have been submitted for this record."
msgstr "Hakuna uchunguzi wa jamii uliowasilishwa kwa rekodi hii."

#: evidence/models.py:112
msgid "Be the first to submit an observation for this record."
msgstr "Kuwa wa kwanza kuwasilisha uchunguzi kwa rekodi hii."

#: evidence/models.py:123
msgid "No recent evidence"
msgstr "Hakuna ushahidi wa hivi karibuni"

#: evidence/models.py:125
#, python-format
msgid ""
"The newest observation is from %(date)s, outside the %(days)s-day recency "
"window."
msgstr ""
"Uchunguzi wa mwisho ni kutoka %(date)s, nje ya kipindi cha siku %(days)s "
"cha hivi karibuni."

#: evidence/models.py:133
msgid ""
"No one has reported on this recently. Submit an observation to bring it up "
"to date."
msgstr ""
"Hakuna aliyeripoti kuhusu hili hivi karibuni. Wasilisha uchunguzi ili "
"kulisasisha."

#: evidence/models.py:150 evidence/models.py:165
msgid "Conflicting evidence"
msgstr "Ushahidi unaopingana"

#: evidence/models.py:152
msgid ""
"Recent observations disagree with each other about the current state of this "
"project."
msgstr ""
"Uchunguzi wa hivi karibuni hazikubaliani kuhusu hali ya sasa ya mradi "
"huu."

#: evidence/models.py:156
msgid ""
"Reports disagree. Submit your own observation to help clarify what is "
"currently happening."
msgstr ""
"Ripoti hazikubaliani. Wasilisha uchunguzi wako kusaidia kufafanua "
"kinachotokea sasa."

#: evidence/models.py:167
msgid "Recent observations do not match the official status."
msgstr "Uchunguzi wa hivi karibuni haufanani na hali rasmi."

#: evidence/models.py:170
msgid ""
"Reports disagree with the official record. Submit your own observation to "
"help clarify what is currently happening."
msgstr ""
"Ripoti hazikubaliani na rekodi rasmi. Wasilisha uchunguzi wako kusaidia "
"kufafanua kinachotokea sasa."

#: evidence/models.py:179
msgid "Aligned evidence"
msgstr "Ushahidi unaolingana"

#: evidence/models.py:180
msgid "Recent observations match the official status."
msgstr "Uchunguzi wa hivi karibuni unafanana na hali rasmi."

#: evidence/models.py:182
msgid ""
"Recent reports confirm the official record. No action is needed, but you can "
"still add what you see."
msgstr ""
"Ripoti za hivi karibuni zinathibitisha rekodi rasmi. Hakuna hatua "
"inayohitajika, lakini unaweza kuongeza ulichokiona."

#: evidence/models.py:195
msgid "Operational"
msgstr "Inafanya kazi"

#: evidence/models.py:196
msgid "Not operational"
msgstr "Haifanyi kazi"

#: evidence/models.py:197
msgid "In progress"
msgstr "Ikiendelea"

#: evidence/models.py:198
msgid "No activity observed"
msgstr "Hakuna shughuli iliyoonekana"

#: evidence/models.py:199
msgid "Other"
msgstr "Nyingine"

#: evidence/models.py:202
msgid "Photo"
msgstr "Picha"

#: evidence/models.py:203
msgid "Video"
msgstr "Video"

#: evidence/models.py:204
msgid "Document"
msgstr "Hati"

#: evidence/models.py:205
msgid "Testimony / eyewitness account"
msgstr "Ushuhuda / maelezo ya shahidi"

#: evidence/templates/evidence/base.html:7
#: evidence/templates/evidence/base.html:20
#: evidence/templates/evidence/project_detail.html:4
msgid "Civic Evidence & Verification"
msgstr "Ushahidi na Uthibitishaji wa Kiraia"

#: evidence/templates/evidence/base.html:14
msgid "Skip to content"
msgstr "Ruka hadi maudhui"

#: evidence/templates/evidence/base.html:23
msgid "Know what was claimed. See what is observed."
msgstr "Fahamu kilichodaiwa. Ona kinachoonekana."

#: evidence/templates/evidence/base.html:27
msgid "Language"
msgstr "Lugha"

#: evidence/templates/evidence/base.html:54
msgid ""
"Proof of concept. Project and observation records shown are demonstration "
"data, not verified government records."
msgstr ""
"Uthibitisho wa dhana. Rekodi za miradi na uchunguzi zinazoonyeshwa ni data "
"ya mfano, si rekodi za serikali zilizothibitishwa."

#: evidence/templates/evidence/base.html:55
msgid ""
"No account is required to browse or submit a report. We do not collect "
"device or location data."
msgstr ""
"Hakuna akaunti inayohitajika kutazama au kuwasilisha ripoti. Hatukusanyi "
"data ya kifaa au mahali."

#: evidence/templates/evidence/home.html:6
msgid "Find a civic project or public service"
msgstr "Tafuta mradi wa kiraia au huduma ya umma"

#: evidence/templates/evidence/home.html:8
#, python-format
msgid ""
"\n"
"      Search %(total_projects)s record to see the official status alongside "
"what the community has reported on the ground.\n"
"    "
msgid_plural ""
"\n"
"      Search %(total_projects)s records to see the official status alongside "
"what the community has reported on the ground.\n"
"    "
msgstr[0] ""
"\n"
"      Tafuta rekodi %(total_projects)s kuona hali rasmi pamoja na yale "
"jamii imeripoti ardhini.\n"
"    "
msgstr[1] ""
"\n"
"      Tafuta rekodi %(total_projects)s kuona hali rasmi pamoja na yale "
"jamii imeripoti ardhini.\n"
"    "

#: evidence/templates/evidence/home.html:15
msgid ""
"Built for residents, journalists, and watchdog groups checking whether an "
"official record matches what is actually happening on the ground."
msgstr ""
"Imejengwa kwa wakazi, waandishi wa habari, na vikundi vya ufuatiliaji "
"vinavyoangalia iwapo rekodi rasmi inalingana na kinachotokea ardhini."

#: evidence/templates/evidence/home.html:25
msgid "Search by project name or location, e.g. Kimumu"
msgstr "Tafuta kwa jina la mradi au mahali, mfano Kimumu"

#: evidence/templates/evidence/home.html:28
msgid "All statuses"
msgstr "Hali zote"

#: evidence/templates/evidence/home.html:33
msgid "Search"
msgstr "Tafuta"

#: evidence/templates/evidence/home.html:48
msgid "View record"
msgstr "Tazama rekodi"

#: evidence/templates/evidence/home.html:53
msgid "No records match that search. Try a different name or location."
msgstr "Hakuna rekodi zinazolingana na utafutaji huo. Jaribu jina au mahali tofauti."

#: evidence/templates/evidence/project_detail.html:7
msgid "All records"
msgstr "Rekodi zote"

#: evidence/templates/evidence/project_detail.html:19
#, python-format
msgid ""
"\n"
"        Based on reports from %(counter)s independent reporter.\n"
"      "
msgid_plural ""
"\n"
"        Based on reports from %(counter)s independent reporters.\n"
"      "
msgstr[0] ""
"\n"
"        Kulingana na ripoti kutoka kwa mripoti %(counter)s huru.\n"
"      "
msgstr[1] ""
"\n"
"        Kulingana na ripoti kutoka kwa waripoti %(counter)s huru.\n"
"      "

#: evidence/templates/evidence/project_detail.html:31
msgid "Official record"
msgstr "Rekodi rasmi"

#: evidence/templates/evidence/project_detail.html:36
msgid "As of"
msgstr "Kufikia"

#: evidence/templates/evidence/project_detail.html:42
msgid "Source"
msgstr "Chanzo"

#: evidence/templates/evidence/project_detail.html:52
msgid "This record is seeded demonstration data for the proof of concept."
msgstr "Rekodi hii ni data ya mfano kwa uthibitisho wa dhana."

#: evidence/templates/evidence/project_detail.html:58
msgid "Community observations"
msgstr "Uchunguzi wa jamii"

#: evidence/templates/evidence/project_detail.html:59
#: evidence/templates/evidence/submit_observation.html:4
#: evidence/templates/evidence/submit_observation.html:10
msgid "Submit an observation"
msgstr "Wasilisha uchunguzi"

#: evidence/templates/evidence/project_detail.html:74
#, python-format
msgid "Submitted by %(name)s"
msgstr "Iliwasilishwa na %(name)s"

#: evidence/templates/evidence/project_detail.html:79
msgid "No observations yet. Be the first to report what you see on the ground."
msgstr "Bado hakuna uchunguzi. Kuwa wa kwanza kuripoti unachokiona ardhini."

#: evidence/templates/evidence/submit_observation.html:15
msgid ""
"No account is required. Leave the name field blank to submit anonymously — "
"we do not collect device or location data."
msgstr ""
"Hakuna akaunti inayohitajika. Acha sehemu ya jina wazi ili kuwasilisha "
"bila jina — hatukusanyi data ya kifaa au mahali."

#: evidence/templates/evidence/submit_observation.html:29
msgid "Submit observation"
msgstr "Wasilisha uchunguzi"

#: evidence/views.py:65
msgid "Observation submitted."
msgstr "Uchunguzi umewasilishwa."
